      "info": "Comma-separated group names as shown in the sidebar. Groups not named here follow in Shopify's own order."
    },
    {
      "type": "text",
      "id": "filter_group_labels",
      "label": "Group names",
      "default": "Level=Player Level, Style=Playing Style",
      "info": "Comma-separated Original=Shown pairs. Works for tag prefixes and Search & Discovery filter names."
    },
    {
      "type": "text",
      "id": "hidden_filter_groups",
      "label": "Hidden filter groups",
      "default": "Series",
      "info": "Comma-separated group names or tag prefixes to leave out of the sidebar. The filter itself keeps working in Search & Discovery."
    },
    {
      "type": "textarea",
      "id": "filter_value_order",
      "label": "Filter value order",
      "default": "Paddles, Balls, Nets, Bags, Beginner, Intermediate, Advanced, Professional, Power, Control, Spin, All Around, Carbon Fiber, Graphite, Fiberglass, Lightweight, Midweight, Heavyweight",
      "info": "Comma-separated value names. Within each group, named values come first in this order; the rest follow in Shopify's order."
    },
    {
      "type": "text",
      "id": "rating_group",
      "label": "Rating tag prefix",
      "default": "Rating",
      "info": "This group is drawn as star rows rather than checkboxes"
    },
    {
      "type": "checkbox",
      "id": "show_unprefixed_tags",
      "label": "Show unprefixed tags",
      "default": false,
      "info": "Tags with no prefix are the ones the automatic collections are built on (Pro Series, Tournament). Off keeps them out of the sidebar."
    },
    {
      "type": "text",
      "id": "link_style_filters",
      "label": "Link-style filter groups",
      "default": "Product Type, Category",
      "info": "Comma-separated filter names drawn as link rows with a result count, like the design's Category group. They stay multi-select. Both spellings of the product-type group are listed so renaming its label in Search & Discovery does not silently change its style."
