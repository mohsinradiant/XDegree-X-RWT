{% comment %}
  Markup copied verbatim from the supplied listing.html (.all-product section):
  the collection title plus the row of paddle-type tiles.

  ---------------------------------------------------------------------------
  WHICH COLLECTIONS SHOW THE TILES

  The tile row only belongs on the paddles collection, so it is switched on
  per collection with the `custom.show_paddle_types` metafield (true/false).
  Every other collection keeps the heading and skips the row.

  ---------------------------------------------------------------------------
  WHERE THE TILES COME FROM

  In this order:

    1. The collection's `custom.paddle_type_tiles` metafield - a list of
       "Paddle type tile" metaobjects (title, image, collection link), edited
       on the collection in the admin. This is the normal source.

    2. A Shopify menu, if one is picked in "Menu": one tile per link, imaged
       from each linked collection's own image.

    3. The manually configured blocks - the fallback if a collection has the
       row switched on but no tiles of its own yet.

  The row is drawn around paddle art (pro01..pro05.png) and
  `.paddles-card--image img` carries no size rule above 767px, so the artwork's
  own dimensions ARE the layout. Do not state width/height on these images and
  do not feed them photos of a different shape; both stretch the tile rather
  than the box.

  A tile linking to the collection you are already on renders as a plain
  tile (listing.html's own markup is a <div>) rather than a link to itself.
{% endcomment %}
{%- comment -%}
  Heading precedence: section setting -> collection metafield -> collection title.
  The metafield lets each collection carry its own headline without editing
  the template.
{%- endcomment -%}
{%- liquid
  assign page_heading = section.settings.heading
  if page_heading == blank
    assign page_heading = collection.metafields.custom.heading.value
  endif
  if page_heading == blank
    assign page_heading = collection.title
  endif

  assign show_tiles = false
  if collection.metafields.custom.show_paddle_types.value == true
    assign show_tiles = true
  endif

  assign metafield_tiles = collection.metafields.custom.paddle_type_tiles.value

  assign menu = section.settings.menu
  assign use_menu = false
  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif
-%}

<section class="all-product py-5">
  <div class="container custom-width">
    {%- comment -%}
      mb-5 pb-4 is listing.html's gap between the heading and the tiles. With
      no tiles below, the section's own py-5 is the whole gap to the toolbar.
    {%- endcomment -%}
    <div class="text-center{% if show_tiles %} mb-5 pb-4{% endif %}">
      <h2 class="all-heading text-capitalize heading-font text-primary">{{ page_heading }}</h2>
    </div>
    {%- if show_tiles -%}
      <div class="row">
        {%- if metafield_tiles != blank -%}
          {%- for tile in metafield_tiles -%}
            {%- liquid
              assign tile_image = tile.image.value
              assign tile_link = tile.link.value
              assign tile_is_link = false
              if tile_link != blank and tile_link.url != collection.url
                assign tile_is_link = true
              endif
            -%}
            <div class="col">
              {%- if tile_is_link -%}
                <a class="paddles-card d-block" href="{{ tile_link.url }}">
              {%- else -%}
                <div class="paddles-card">
              {%- endif -%}
                <div class="paddles-card--image">
                  {%- if tile_image != blank -%}
                    <img src="{{ tile_image | image_url: width: 400 }}" loading="lazy" alt="{{ tile_image.alt | default: tile.title.value | escape }}">
                  {%- endif -%}
                </div>
                <h4 class="paddles-card-title text-uppercase heading-font">{{ tile.title.value | escape }}</h4>
              {%- if tile_is_link -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- elsif use_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              # `link.object` is the collection itself for a collection link,
              # so the tile uses the artwork the merchant set on the collection
              # and nothing else. Falling back to its first product's photo puts
              # a tall paddle shot where the design wants category art, and
              # .paddles-card--image img is unconstrained on desktop so nothing
              # downstream would rein it in.
              assign linked = link.object
              assign tile_image = blank
              if link.type == 'collection_link'
                assign tile_image = linked.image
              endif
            -%}
            {%- unless link.current -%}
              <div class="col">
                <a class="paddles-card d-block" href="{{ link.url }}">
                  <div class="paddles-card--image">
                    {%- if tile_image != blank -%}
                      <img src="{{ tile_image | image_url: width: 400 }}" loading="lazy" alt="{{ tile_image.alt | default: link.title | escape }}">
                    {%- endif -%}
                  </div>
                  <h4 class="paddles-card-title text-uppercase heading-font">{{ link.title | escape }}</h4>
                </a>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <div class="col" {{ block.shopify_attributes }}>
              <a class="paddles-card d-block" href="{{ block.settings.link | default: '#' }}">
                <div class="paddles-card--image">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 400 }}" loading="lazy" alt="{{ block.settings.image.alt | escape }}">
                  {%- endif -%}
                </div>
                <h4 class="paddles-card-title text-uppercase heading-font">{{ block.settings.title }}</h4>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "XD Collection categories",
  "settings": [
    {
      "type": "paragraph",
      "content": "The tile row shows only on collections whose \"Show paddle-type tiles\" metafield is on. Tiles come from that collection's \"Paddle-type tiles\" metafield; the menu or blocks below are used only when it is empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection's custom.heading metafield, then its title"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Fallback: one tile per link, using each linked collection's own image. Leave empty to use the blocks below instead."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Paddle type",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Power" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "XD Collection categories",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
