{% comment %}
  Markup copied verbatim from the supplied "product display page.html"
  (.product-description-section). Bootstrap tabs.

  Everything in this section comes from the product, not from section
  settings: the `custom.product_tabs` metafield lists "Product tab" metaobjects
  in display order, and each entry carries

    title       - the tab label
    content     - rich text body; left empty, the product description is used
                  (that is how The Story tab works, so descriptions are not
                  duplicated and keep their own images)
    image       - optional side image; switches the pane to the design's
                  text + image two-column layout
    stat_value  - optional stat card on that image, e.g. 16 / mm / Core
    stat_unit     Thickness
    stat_label

  Shared entries (Shipping & Returns, Warranty...) are referenced by many
  products, so their copy is edited once. A product with no tabs listed
  renders no tab section at all rather than an empty bar.
{% endcomment %}
{%- assign tabs = product.metafields.custom.product_tabs.value -%}
{%- if tabs != blank -%}
  <section class="product-description-section bg-light section-tb-padding96 pt-0 mt-5">
    <div class="container custom-width">
      <div class="product-tabs">
        {%- comment -%}
          The bar is wrapped so the mobile edge-fade can be painted on a static
          element. Put on the scroller itself it would scroll away with the
          tabs; on the wrapper it stays pinned to the right edge.
        {%- endcomment -%}
        <div class="product-tabs__bar">
        <ul class="nav nav-tabs border-0" id="myTab" role="tablist">
          {%- for tab in tabs -%}
            <li class="nav-item" role="presentation">
              <button
                class="nav-link heading-font2{% if forloop.first %} active{% endif %}"
                id="xd-tab-{{ section.id }}-{{ forloop.index }}"
                data-bs-toggle="tab"
                data-bs-target="#xd-pane-{{ section.id }}-{{ forloop.index }}"
                type="button"
                role="tab"
              >
                {{- tab.title.value | escape -}}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        </div>
        <div class="tab-content p-4">
          {%- for tab in tabs -%}
            {%- liquid
              assign tab_image = tab.image.value
              assign stat_value = tab.stat_value.value
              assign has_content = false
              if tab.content.value != blank
                assign has_content = true
              endif
            -%}
            {%- comment -%}
              xd-pane--<label> is the styling hook for per-tab heading rules
              in xd-overrides.css (Details & Care, Shipping & Returns...).
            {%- endcomment -%}
            <div
              class="tab-pane fade{% if forloop.first %} show active{% endif %} xd-pane--{{ tab.title.value | handleize }}"
              id="xd-pane-{{ section.id }}-{{ forloop.index }}"
              role="tabpanel"
            >
              <div class="row text-primary">
                {%- if tab_image != blank -%}
                  <div class="col-md-6">
                    {%- if has_content -%}{{ tab.content | metafield_tag }}{%- else -%}{{ product.description }}{%- endif -%}
                  </div>
                  <div class="col-md-6">
                    <div class="tab-right-image">
                      <img
                        src="{{ tab_image | image_url: width: 1000 }}"
                        class="img-fluid"
                        alt="{{ tab_image.alt | escape }}"
                        width="{{ tab_image.width }}"
                        height="{{ tab_image.height }}"
                      >
                      {%- if stat_value != blank -%}
                        <div class="tab-right-image-box">
                          <div class="heading-font fs49 text-primary lh100 fw600">
                            {{- stat_value -}}
                            <span class="text-drak-crimson-red">{{ tab.stat_unit.value }}</span>
                          </div>
                          <div class="fs12 text-uppercase text-primary">{{ tab.stat_label.value }}</div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- elsif has_content -%}
                  {%- comment -%}
                    A rich text field has to go through `metafield_tag`;
                    outputting its `.value` dumps raw JSON instead.
                  {%- endcomment -%}
                  <div class="col-md-12 text-primary">{{ tab.content | metafield_tag }}</div>
                {%- else -%}
                  {%- comment -%}
                    The product description ships its own .col-* grid, so it
                    goes straight into the .row.
                  {%- endcomment -%}
                  {{ product.description }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "XD Product tabs",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tabs come from each product's \"Product tabs\" metafield (Products > a product > Metafields). Edit tab labels, content, images and stat cards in Content > Metaobjects > Product tab."
    }
  ],
  "presets": [
    {
      "name": "XD Product tabs"
    }
  ]
}
{% endschema %}
