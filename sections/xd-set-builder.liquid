{% comment %}
  Markup based on the supplied index.html (pickleball-card section).

  Changed vs source: the backdrop is passed as CSS custom properties instead of
  a hard-coded inline background-image, so xd-responsive.css can swap in the
  mobile crop at the breakpoint. An inline style would always win over a
  stylesheet rule, which is why the URL cannot stay in the style attribute.
{% endcomment %}
{%- liquid
  # The price label ships as "Starting<br>From". A raw <br> forces two lines at
  # every width, and there is no reliable way to put a space back where one has
  # been hidden - so split it into spans instead and let CSS choose: block on
  # desktop (two lines, as designed), inline on mobile (one row).
  assign label_norm = section.settings.price_label | replace: '<br/>', '<br>' | replace: '<br />', '<br>'
  assign label_parts = label_norm | split: '<br>'

  assign bg = section.settings.background_image | image_url: width: 3840
  assign bg_mobile_image = section.settings.background_image_mobile | default: section.settings.background_image
  assign bg_mobile = bg_mobile_image | image_url: width: 1200
-%}

<section
  class="xd-set-builder section-t-padding96"
  style="--xd-bg: url({{ bg }}); --xd-bg-mobile: url({{ bg_mobile }}); background-size: cover;"
>
  <div class="container custom-width">
    <div class="section-heading mb-5 text-center">
      <div class="sub-heading">{{ section.settings.eyebrow }}</div>
      <h3 class="all-heading heading-font text-white">{{ section.settings.heading }}</h3>
    </div>
    <div class="row pickleball-card bg-black pb-0">
      <div class="col-lg-4">
        <div class="pickleball-card--widget">
          <h4 class="pickleball-card--widget--title heading-font">
            {{ section.settings.panel_heading }}
            <span class="text-drak-crimson-red">{{ section.settings.panel_heading_highlight }}</span>
            {{ section.settings.panel_heading_end }}
          </h4>
          <p class="mb-0 text-white fs14 fw500 mt-2 pickleball-card__sub">{{ section.settings.panel_subtext }}</p>
          {%- comment -%}
            Below 768px this becomes a single-row marquee instead of a stacked
            list, which is worth roughly 130px of section height. The blocks are
            rendered twice so the track can loop seamlessly: the animation
            translates exactly -50%, at which point copy 2 sits where copy 1
            started. The duplicate is aria-hidden so it is not read out twice.

            On desktop the wrapper is a plain div and the <ul> is the same
            stacked list it always was - the second copy is hidden by CSS.
          {%- endcomment -%}
          <div class="pickleball-card-marquee">
            <ul class="list-unstyled m-0 p-0 pickleball-card-list my-4">
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endfor -%}
              {%- for block in section.blocks -%}
                <li class="pickleball-card-list__clone" aria-hidden="true">{{ block.settings.text }}</li>
              {%- endfor -%}
            </ul>
          </div>
          <div class="d-flex align-items-center gap-3 mb-4 pickleball-card__pricing">
            <div class="text-end fs13 lh100 text-white fw500 pickleball-card__price-label">
              {%- for part in label_parts -%}
                <span>{{ part }}</span>{% unless forloop.last %} {% endunless %}
              {%- endfor -%}
            </div>
            <div class="pickleball-card--price fs29 fw700 text-white">{{ section.settings.price }}</div>
          </div>
          <a href="{{ section.settings.button_link | default: '#' }}" class="heading-font btn btn-primary pickleball-card__cta">
            {{ section.settings.button_label }}
            <span class="btn-icon"><img src="{{ 'rt-icon.svg' | asset_url }}" alt=""></span>
          </a>
        </div>
      </div>
      <div class="col-lg-6 offset-2 d-flex align-items-end justify-content-end px-5 pb-5 pickleball-card__media">
        {%- if section.settings.side_image != blank -%}
          <img src="{{ section.settings.side_image | image_url: width: 984 }}" class="img-fluid" alt="">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "XD Set builder banner",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Section background image (desktop)" },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Section background image (mobile)",
      "info": "Recommended 900 x 1400px (portrait). Used below 768px. Falls back to the desktop image if left empty."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Build Your Own" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pickleball Set" },
    { "type": "header", "content": "Panel" },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Panel heading start",
      "default": "Get Discount on your own"
    },
    {
      "type": "text",
      "id": "panel_heading_highlight",
      "label": "Panel heading highlighted word",
      "default": "PIckleball"
    },
    { "type": "text", "id": "panel_heading_end", "label": "Panel heading end", "default": "Set" },
    {
      "type": "text",
      "id": "panel_subtext",
      "label": "Panel subtext",
      "default": "CHOOSE PADDLE, BALLS & BAG oF Your Own CHoice"
    },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Starting<br>From" },
    { "type": "text", "id": "price", "label": "Price", "default": "₹8,499" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose your Set" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "side_image", "label": "Side image" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature line",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "99% Sweet Spot, Zero Dead Spots" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "XD Set builder banner",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
