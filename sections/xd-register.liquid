{% comment %}
  Markup copied verbatim from the supplied register.html (.register-wrapper).

  A registration is sent to the store in up to two ways:

    1. Always: Shopify's native contact form, so it arrives as a store
       notification email with every field.

    2. When the shopper ticks the consent box: also as a customer in
       Admin > Customers, tagged with the "Customer tag" setting plus
       "Country: ..." / "City: ..." from the dropdowns. Shopify's storefront
       customer form always subscribes that customer to email marketing, which
       is why this only happens with the box ticked.

  HOW THE TWO SUBMISSIONS COEXIST

  Both forms are protected by Shopify's hCaptcha, which only accepts forms the
  theme renders with {% form %} and submits natively - a fetch() is rejected
  with "Missing CAPTCHA token". So the customer form is a real, visually hidden
  {% form 'customer' %} whose target is a hidden iframe. Once the captcha is
  bound, Shopify submits it with the native form.submit(), which honours
  target, so the page does not navigate.

  On submit (box ticked), a capture-phase listener on window runs before
  Shopify's own submit handling, holds the contact form, copies the fields
  into the customer form and submits that into the iframe. When the iframe
  loads - or after a timeout, so a slow or challenged captcha can never lose
  the registration email - the contact form is submitted again and goes
  through Shopify's normal flow.

  The phone number is only copied to the customer when it is in international
  format (+ and digits): Shopify rejects the whole customer for any other
  phone format. It always reaches the email.
{% endcomment %}
<section class="register-wrapper bg-light">
  <div class="register-container position-relative">
    {%- if section.settings.image != blank -%}
      <figure class="register-image" style="background-image: url({{ section.settings.image | image_url: width: 1600 }});">
        <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | escape }}">
      </figure>
    {%- endif -%}
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-5 py-5">
          <div class="register-form">
            <h4 class="text-center fs30 heading-font mb-5 text-primary fw800">{{ section.settings.heading }}</h4>
            {%- form 'contact', id: 'XdRegisterForm', class: 'w-100' -%}
              {%- if form.posted_successfully? -%}
                <p class="form__message fs14 text-center mb-3">{{ section.settings.success_text }}</p>
              {%- elsif form.errors -%}
                <p class="form__message fs14 text-center mb-3 text-drak-crimson-red">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              <div class="form-group mb-3">
                <input type="text" name="contact[name]" class="form-control" placeholder="{{ section.settings.name_label }}" required data-xd-register="name">
              </div>
              <div class="form-group mb-3">
                <input type="email" name="contact[email]" class="form-control" placeholder="{{ section.settings.email_label }}" required data-xd-register="email">
              </div>
              <div class="form-group mb-3">
                <input type="tel" name="contact[phone]" class="form-control" placeholder="{{ section.settings.phone_label }}" data-xd-register="phone">
              </div>
              {%- for block in section.blocks -%}
                <div class="form-group mb-3" {{ block.shopify_attributes }}>
                  <select name="contact[{{ block.settings.label | handleize }}]" class="form-control" data-xd-register-tag="{{ block.settings.label | escape }}">
                    <option value="">{{ block.settings.label }}</option>
                    {%- assign opts = block.settings.options | split: ',' -%}
                    {%- for o in opts -%}
                      <option value="{{ o | strip | escape }}">{{ o | strip }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
              {%- if section.settings.save_as_customer -%}
                <div class="form-check mb-3">
                  <input
                    type="checkbox"
                    class="form-check-input"
                    id="XdRegisterConsent"
                    name="contact[{{ section.settings.consent_label | escape }}]"
                    value="Yes"
                    data-xd-register="consent"
                  >
                  <label class="form-check-label" for="XdRegisterConsent">{{ section.settings.consent_label }}</label>
                </div>
              {%- endif -%}
              <div class="form-group">
                <button type="submit" class="btn w-100 sm-btn product-card-btn submit-btn btn-primary">
                  <span class="text-center">{{ section.settings.button_label }}</span>
                  <span class="btn-icon"><img src="{{ 'rt-icon.svg' | asset_url }}" alt=""></span>
                </button>
              </div>
            {%- endform -%}

            {%- if section.settings.save_as_customer -%}
              {%- comment -%}
                Sibling, not child, of the contact form: forms cannot nest.
                visually-hidden rather than display:none so the invisible
                captcha widget Shopify places inside it can still render.
              {%- endcomment -%}
              {%- form 'customer', id: 'XdRegisterCustomer', class: 'visually-hidden', novalidate: 'novalidate' -%}
                <input type="hidden" name="contact[email]" value="">
                <input type="hidden" name="contact[first_name]" value="">
                <input type="hidden" name="contact[last_name]" value="">
                <input type="hidden" name="contact[phone]" value="" disabled>
                <input type="hidden" name="contact[tags]" value="">
              {%- endform -%}
              <iframe name="XdRegisterSink" title="" tabindex="-1" aria-hidden="true" class="visually-hidden"></iframe>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- if section.settings.save_as_customer -%}
  <script>
    (function () {
      var contact = document.getElementById('XdRegisterForm');
      var customer = document.getElementById('XdRegisterCustomer');
      var sink = document.querySelector('iframe[name="XdRegisterSink"]');
      if (!contact || !customer || !sink) return;

      var BASE_TAG = {{ section.settings.customer_tag | json }};
      // Long enough for an invisible captcha round trip; short enough that a
      // shopper stuck on a captcha challenge still gets their email sent.
      var WAIT_MS = 20000;
      var customerDone = false;

      customer.target = 'XdRegisterSink';

      // Bind Shopify's captcha to the hidden form up front: it is otherwise
      // bound on focus, which a hidden form never receives.
      if (window.Shopify && window.Shopify.captcha && typeof window.Shopify.captcha.protect === 'function') {
        window.Shopify.captcha.protect(customer);
      }

      function field(name) {
        return contact.querySelector('[data-xd-register="' + name + '"]');
      }

      function clean(value) {
        // A comma would split one tag into two.
        return String(value || '').replace(/,/g, ' ').replace(/\s+/g, ' ').trim();
      }

      function fillCustomer() {
        var name = clean(field('name') && field('name').value);
        var parts = name.split(' ');
        customer.elements['contact[email]'].value = (field('email') && field('email').value || '').trim();
        customer.elements['contact[first_name]'].value = parts.shift() || '';
        customer.elements['contact[last_name]'].value = parts.join(' ');

        var phone = (field('phone') && field('phone').value || '').replace(/[\s().-]/g, '');
        var phoneInput = customer.elements['contact[phone]'];
        var international = /^\+\d{8,15}$/.test(phone);
        phoneInput.value = international ? phone : '';
        phoneInput.disabled = !international;

        var tags = [BASE_TAG];
        contact.querySelectorAll('[data-xd-register-tag]').forEach(function (select) {
          if (select.value) tags.push(clean(select.getAttribute('data-xd-register-tag')) + ': ' + clean(select.value));
        });
        customer.elements['contact[tags]'].value = tags.filter(Boolean).join(',');
      }

      function sendContact() {
        customerDone = true;
        if (typeof contact.requestSubmit === 'function') contact.requestSubmit();
        else contact.submit();
      }

      // Capture phase on window runs before Shopify's captcha listeners on the
      // form, so the contact submission can be held until the customer is sent.
      window.addEventListener(
        'submit',
        function (event) {
          if (event.target !== contact || customerDone) return;
          var consent = field('consent');
          if (!consent || !consent.checked) return;

          event.preventDefault();
          event.stopImmediatePropagation();

          fillCustomer();
          var timer = setTimeout(sendContact, WAIT_MS);
          sink.addEventListener(
            'load',
            function () {
              clearTimeout(timer);
              sendContact();
            },
            { once: true }
          );
          if (typeof customer.requestSubmit === 'function') customer.requestSubmit();
          else customer.submit();
        },
        true
      );
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "XD Register",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fill out the information below to register your paddle" },
    { "type": "text", "id": "name_label", "label": "Name placeholder", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "phone_label", "label": "Phone placeholder", "default": "Phone No." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "submit" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks - your paddle registration has been received." },
    { "type": "header", "content": "Save to Customers" },
    {
      "type": "checkbox",
      "id": "save_as_customer",
      "label": "Also save registrations as customers",
      "default": true,
      "info": "Only when the shopper ticks the consent box. Shopify subscribes these customers to email marketing. Registrations are always emailed to the store as well."
    },
    { "type": "text", "id": "consent_label", "label": "Consent checkbox label", "default": "Keep me updated about my paddle and XDegree news" },
    { "type": "text", "id": "customer_tag", "label": "Customer tag", "default": "paddle-registration", "info": "Plus one tag per dropdown, e.g. \"Country: India\"" }
  ],
  "blocks": [
    {
      "type": "select", "name": "Dropdown",
      "settings": [
        { "type": "text", "id": "label", "label": "Label / placeholder", "default": "Country" },
        { "type": "textarea", "id": "options", "label": "Options (comma separated)", "default": "India, United States, United Kingdom" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "XD Register", "blocks": [{ "type": "select" }, { "type": "select" }] }]
}
{% endschema %}
