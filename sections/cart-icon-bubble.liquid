{% comment %}
  Rendered inside the header's #cart-icon-bubble anchor AND re-rendered into it
  by Dawn's cart-drawer.js after every cart update, so the markup must match
  the header exactly. Uses the design's Font Awesome cart glyph.
{% endcomment %}
<i class="fa-regular fa-cart-shopping-fast"></i>
<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <span class="xd-cart-bubble" aria-hidden="true">{{ cart.item_count }}</span>
  <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
{%- endif -%}
